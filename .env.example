# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Optional: trace every graph node and LLM call in LangSmith (https://smith.langchain.com)
# LANGSMITH_API_KEY=lsv2-your-key-here
# LANGSMITH_PROJECT=hakusho-research

# Optional overrides (defaults shown)
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# RETRIEVE_K=8
# CONTEXT_K=5
# MAX_QUERY_REWRITES=1
# MAX_HISTORY_TURNS=3
